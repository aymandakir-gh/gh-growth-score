# App
LEADS_API_URL=
NODE_ENV=development

# Sentry — error monitoring (optional; app degrades gracefully without it)
# Set NEXT_PUBLIC_SENTRY_DSN to your project DSN from sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — product analytics (optional; app degrades gracefully without it)
# Set NEXT_PUBLIC_POSTHOG_KEY to your project API key from posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
# Override if self-hosting PostHog; defaults to EU cloud
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
